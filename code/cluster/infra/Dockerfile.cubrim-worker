# Dockerfile.cubrim-worker — Single image for all Cubrim cluster roles.
#
# Bundles: Node.js 24.22.1, Claude Code CLI, claude-code-router, Rust/cargo,
#          python3 + numpy, jq, git.
#
# All four containers (orchestrator + workers a/b/c) use this same image.
# The role is determined at runtime by the --env-file passed to docker compose,
# which sets ANTHROPIC_BASE_URL, ANTHROPIC_AUTH_TOKEN, and ANTHROPIC_MODEL
# per slot — nothing in this image is role-specific.
#
# Base: ubuntu:24.04 (LTS, amd64)
# Identity (Law 5): containers carry 'cubrim-role' label set in compose file.

FROM ubuntu:24.04

# Prevent interactive prompts during package install
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# ── system packages ──────────────────────────────────────────────────────────
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        git \
        jq \
        curl \
        ca-certificates \
        gnupg \
        lsb-release \
        build-essential \
        python3 \
        python3-pip \
        python3-dev \
        xz-utils \
        && \
    rm -rf /var/lib/apt/lists/*

# ── Node.js 24.22.1 (Active LTS "Krypton") ──────────────────────────────────
# Exact pin for the 2026-10-21 security release (patched lines: 26.12.1,
# 24.22.1, 22.23.4). Ubuntu 24.04 apt nodejs is 18.19.1 and is not used.
# Official linux-x64 tarball. SHA-256 is the linux-x64 line of
# https://nodejs.org/dist/v24.22.1/SHASUMS256.txt
# (clearsigned by Node.js release key 5BE8A3F6C8A5C01D106C0AD820B1A390B168D356).
# The image is amd64; any other architecture fails closed.
ARG NODE_VERSION=24.22.1
ARG NODE_SHA256=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         amd64) ;; \
         *) echo "pinned Node.js tarball is linux-x64 only (got ${arch})" >&2; exit 1 ;; \
       esac \
    && tarball="node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && curl -fsSL -o "/tmp/${tarball}" "https://nodejs.org/dist/v${NODE_VERSION}/${tarball}" \
    && echo "${NODE_SHA256}  /tmp/${tarball}" | sha256sum -c - \
    && tar -xJf "/tmp/${tarball}" -C /usr/local --strip-components=1 \
    && rm -f "/tmp/${tarball}" \
    && node -v \
    && npm -v

# ── Python dependencies ──────────────────────────────────────────────────────
# ubuntu:24.04 ships an externally-managed Python (PEP 668); inside this
# dedicated image a global install is safe, so allow it explicitly.
RUN pip3 install --no-cache-dir --break-system-packages numpy

# ── Rust toolchain ───────────────────────────────────────────────────────────
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:${PATH}

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --no-modify-path --default-toolchain stable && \
    rustup component add rustfmt clippy

# ── Claude Code CLI ───────────────────────────────────────────────────────────
RUN npm install -g @anthropic-ai/claude-code

# ── claude-code-router ────────────────────────────────────────────────────────
# Installed from npm (the canonical distribution — there is no GitHub release
# binary). Provides the `ccr` command used for per-worker model routing.
RUN npm install -g @musistudio/claude-code-router

# ── PATH must include ~/.local/bin (PAX lesson — systemd non-login PATH gap) ─
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin:/usr/local/cargo/bin

# ── workspace ────────────────────────────────────────────────────────────────
WORKDIR /workspace

# Default entry: bash (overridden by compose command per container role)
CMD ["/bin/bash"]
